---
import SocialLinks from "./SocialLinks.astro";

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="#home" class="footer-logo">
          Carlos <span class="gradient-text">Miguel</span>
        </a>
        <p class="footer-tagline">
          Desarrollador Web FullStack creando productos digitales modernos,
          accesibles y de alto rendimiento.
        </p>
      </div>

      <div class="footer-column">
        <h3 class="footer-heading">Navegación</h3>
        <nav class="footer-nav" aria-label="Navegación del pie de página">
          <ul class="nav-list">
            <li><a href="#home" class="footer-link">Inicio</a></li>
            <li><a href="#about" class="footer-link">Sobre Mí</a></li>
            <li><a href="#projects" class="footer-link">Proyectos</a></li>
          </ul>
        </nav>
      </div>

      <div class="footer-column footer-social-col">
        <h3 class="footer-heading">Contacto</h3>
        <p class="social-subtitle">
          ¿Tienes una idea o proyecto en mente? Conectemos.
        </p>
        <SocialLinks />
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-meta">
        <p class="copyright-text">
          &copy; {currentYear}{" "}<span class="author-name">Carlos Miguel</span>. Todos los derechos
          reservados.
        </p>
        <p class="developed-by">
          Desarrollado con{" "}
          <a
            href="https://astro.build"
            target="_blank"
            rel="noopener noreferrer"
            class="astro-badge"
            aria-label="Sitio web oficial de Astro"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="astro-icon"
              aria-hidden="true"
            >
              <path
                d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"
              ></path>
              <path
                d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"
              ></path>
              <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path>
              <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path>
            </svg>
            <span>Astro</span>
          </a>
        </p>
      </div>

      <a href="#home" class="back-to-top" aria-label="Volver al inicio">
        <span>Volver arriba</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="arrow-up-icon"
          aria-hidden="true"
        >
          <line x1="12" y1="19" x2="12" y2="5"></line>
          <polyline points="5 12 12 5 19 12"></polyline>
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: auto;
    width: 100%;
    background-color: var(--bg-primary);
    background-image: radial-gradient(
      circle at 50% 0%,
      rgba(56, 189, 248, 0.05) 0%,
      transparent 65%
    );
    border-top: 1px solid var(--border-color);
    padding: 3.5rem 1.5rem 2.25rem;
    overflow: hidden;
  }

  /* Línea superior con resplandor sutil */
  .footer::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    width: min(700px, 85%);
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-primary),
      var(--color-secondary),
      transparent
    );
    opacity: 0.75;
  }

  .footer-container {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }

  /* Disposición en cuadrícula principal */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1.6fr;
    gap: 2.5rem;
    align-items: start;
  }

  /* Columna Marca */
  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-logo {
    display: inline-block;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
    transition: transform var(--transition-fast);
  }

  .footer-logo:hover {
    transform: translateY(-1px);
  }

  .footer-logo:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .gradient-text {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .footer-tagline {
    color: var(--text-secondary);
    font-size: 0.925rem;
    line-height: 1.6;
    margin: 0;
    max-width: 340px;
  }

  /* Títulos de sección */
  .footer-heading {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.075em;
    color: var(--text-primary);
    margin: 0 0 1rem 0;
  }

  /* Navegación */
  .footer-column {
    display: flex;
    flex-direction: column;
  }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.925rem;
    display: inline-flex;
    align-items: center;
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--color-primary);
    transform: translateX(3px);
  }

  .footer-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* Redes sociales y contacto */
  .social-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0 0 1rem 0;
    max-width: 320px;
  }

  /* Barra inferior */
  .footer-bottom {
    border-top: 1px solid var(--border-color);
    padding-top: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .copyright-text {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin: 0;
  }

  .author-name {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .developed-by {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  /* Badge de Astro */
  .astro-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.15rem 0.55rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    color: var(--text-primary);
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .astro-badge:hover {
    color: var(--color-primary);
    background-color: var(--bg-secondary);
    border-color: var(--border-color-hover);
    transform: translateY(-1px);
    box-shadow: var(--shadow-glow);
  }

  .astro-badge:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .astro-icon {
    color: #f43f5e;
    transition:
      transform var(--transition-fast),
      color var(--transition-fast);
  }

  .astro-badge:hover .astro-icon {
    transform: rotate(-10deg) scale(1.15);
    color: var(--color-primary);
  }

  /* Botón volver arriba */
  .back-to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.95rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .back-to-top:hover {
    color: var(--text-primary);
    background-color: var(--bg-secondary);
    border-color: var(--border-color-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow);
  }

  .back-to-top:active {
    transform: translateY(0);
  }

  .back-to-top:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .arrow-up-icon {
    transition:
      transform var(--transition-fast),
      stroke var(--transition-fast);
  }

  .back-to-top:hover .arrow-up-icon {
    transform: translateY(-3px);
    stroke: var(--color-primary);
  }

  /* Responsive */
  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .footer-social-col {
      grid-column: span 2;
    }
  }

  @media (max-width: 600px) {
    .footer {
      padding: 3rem 1.25rem 2rem;
    }

    .footer-container {
      gap: 2.25rem;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-social-col {
      grid-column: auto;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }

    .back-to-top {
      align-self: flex-start;
    }
  }
</style>
