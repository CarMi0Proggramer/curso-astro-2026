---
import { Image } from "astro:assets";
import { SKILL_ICONS } from "../constants/skillIcons";

interface Props {
  name: string;
  description: string;
  imageUrl: string;
  skills?: (keyof typeof SKILL_ICONS)[];
  link: string;
}

const { name, description, imageUrl, skills = [], link } = Astro.props;
const isExternal = link?.startsWith("http");
const displayUrl = `${name.toLowerCase().replace(/\s+/g, "-")}.dev`;
---

<article class="project-card">
  <div class="project-image-wrapper">
    <div class="browser-bar" aria-hidden="true">
      <div class="browser-dots">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
      </div>
      <span class="browser-url">{displayUrl}</span>
    </div>

    <div class="image-box">
      <Image
        src={imageUrl}
        alt={`Captura del proyecto ${name}`}
        width="600"
        height="375"
        class="project-image"
        loading="lazy"
        decoding="async"
      />
      <div class="project-image-overlay"></div>
    </div>
  </div>

  <div class="project-content">
    <h3 class="project-title">{name}</h3>
    <p class="project-description">{description}</p>

    {
      skills.length > 0 && (
        <div class="project-skills">
          {skills.map((skill: keyof typeof SKILL_ICONS) => {
            const Icon = SKILL_ICONS[skill] ?? null;

            return (
              <span class="skill-badge">
                {Icon && (
                  <span class="skill-icon">
                    <Icon />
                  </span>
                )}
                <span>{skill}</span>
              </span>
            );
          })}
        </div>
      )
    }

    <div class="project-footer">
      <a
        href={link}
        class="project-link"
        target={isExternal ? "_blank" : undefined}
        rel={isExternal ? "noopener noreferrer" : undefined}
      >
        <span>Ver Proyecto</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="link-icon"
          aria-hidden="true"
        >
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
          ></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .project-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .project-card:hover {
    transform: translateY(-5px);
    border-color: var(--border-color-hover);
    box-shadow: var(--shadow-glow);
  }

  /* Mockup de Navegador para la Imagen */
  .project-image-wrapper {
    position: relative;
    width: 100%;
    background-color: var(--bg-card);
    border-bottom: 1px solid var(--border-color);
    overflow: hidden;
  }

  .browser-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.45rem 0.85rem;
    background-color: rgba(15, 23, 42, 0.7);
    border-bottom: 1px solid var(--border-color);
  }

  .browser-dots {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot.red {
    background-color: #ef4444;
  }

  .dot.yellow {
    background-color: #f59e0b;
  }

  .dot.green {
    background-color: #10b981;
  }

  .browser-url {
    font-size: 0.72rem;
    font-family: monospace;
    color: var(--text-muted);
    background-color: rgba(0, 0, 0, 0.25);
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  /* Contenedor uniforme para la imagen */
  .image-box {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: #0b1120;
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .project-card:hover .project-image {
    transform: scale(1.05);
  }

  .project-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 60%,
      rgba(10, 15, 29, 0.45) 100%
    );
    pointer-events: none;
    transition: opacity var(--transition-fast);
  }

  .project-card:hover .project-image-overlay {
    opacity: 0.5;
  }

  /* Contenido y textos */
  .project-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 1.5rem;
    gap: 0.85rem;
  }

  .project-title {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .project-description {
    color: var(--text-secondary);
    font-size: 0.925rem;
    line-height: 1.6;
    margin: 0;
    flex-grow: 1;
  }

  /* Badges de Tecnologías */
  .project-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.25rem;
    margin-bottom: 0.5rem;
  }

  .skill-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    font-size: 0.775rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast);
  }

  .skill-badge:hover {
    border-color: var(--border-color-hover);
    color: var(--text-primary);
  }

  .skill-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .skill-icon :global(svg) {
    width: 14px;
    height: 14px;
    display: block;
  }

  /* Footer con botón */
  .project-footer {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.55rem 1.15rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .project-link:hover {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: #070b14;
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(56, 189, 248, 0.4);
  }

  .project-link:active {
    transform: translateY(0);
  }

  .project-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .link-icon {
    transition: transform var(--transition-fast);
  }

  .project-link:hover .link-icon {
    transform: translate(2px, -2px);
  }
</style>
