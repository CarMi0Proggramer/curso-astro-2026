---
import About from "../components/About.astro";
import Hero from "../components/Hero.astro";
import Project from "../components/Project.astro";
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/projects.json";
---

<Layout>
  <Hero />
  <main>
    <About />
    <section id="projects" class="projects">
      <div class="projects-container">
        <header class="section-header">
          <div class="section-kicker">
            <span class="badge">Portafolio</span>
          </div>
          <h2 class="projects-title">
            Proyectos <span class="gradient-text">Destacados</span>
          </h2>
          <p class="projects-subtitle">
            Una selección de proyectos y aplicaciones web que he desarrollado,
            enfocadas en experiencia de usuario, diseño limpio y tecnologías modernas.
          </p>
        </header>

        <div class="projects-grid">
          {projects.map((project) => <Project {...project} />)}
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .projects {
    position: relative;
    padding: 5rem 1.5rem;
    scroll-margin-top: 5rem;
    width: 100%;
  }

  .projects-container {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }

  /* Encabezado de la sección */
  .section-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .section-kicker {
    margin-bottom: 0.5rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.85rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .projects-title {
    font-size: clamp(2rem, 4.2vw, 2.75rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin: 0.5rem 0 0.85rem 0;
  }

  .gradient-text {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .projects-subtitle {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 640px;
    margin: 0;
  }

  /* Grid de Proyectos */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
    gap: 2rem;
    align-items: stretch;
  }

  @media (max-width: 640px) {
    .projects {
      padding: 3.5rem 1.25rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
