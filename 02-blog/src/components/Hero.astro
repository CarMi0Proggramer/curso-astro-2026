---
interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
}

const {
  badge = "DevLab Studio",
  title = "Transforma ideas en experiencias digitales que venden.",
  subtitle = "En DevLab creamos productos web modernos, rápidos y estratégicos para marcas que quieren destacar, conectar con su audiencia y crecer sin límites.",
  ctaText = "Ver Publicaciones",
  ctaHref = "#posts",
} = Astro.props;
---

<header class="hero">
  <div class="hero-content">
    {
      badge && (
        <div class="hero-badge">
          <span class="badge-dot" />
          <span>{badge}</span>
        </div>
      )
    }

    <h1 class="hero-title">
      <span class="highlight-gradient">{title}</span>
    </h1>

    <p class="hero-description">
      {subtitle}
    </p>

    <a href={ctaHref} class="hero-cta" role="button">
      <span>{ctaText}</span>
      <svg
        class="arrow-icon"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 640 640"
        aria-hidden="true"
      >
        <path
          d="M297.4 598.6C309.9 611.1 330.2 611.1 342.7 598.6L470.7 470.6C483.2 458.1 483.2 437.8 470.7 425.3C458.2 412.8 437.9 412.8 425.4 425.3L352 498.7L352 64C352 46.3 337.7 32 320 32C302.3 32 288 46.3 288 64L288 498.7L214.6 425.3C202.1 412.8 181.8 412.8 169.3 425.3C156.8 437.8 156.8 458.1 169.3 470.6L297.3 598.6z"
        ></path>
      </svg>
    </a>
  </div>
</header>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 7rem 1.5rem 6rem;
    min-height: 80vh;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, black 85%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 85%, transparent 100%);
  }

  /* Resplandor ambiental de fondo */
  .hero::before {
    content: "";
    position: absolute;
    top: 15%;
    left: 50%;
    transform: translate(-50%, -20%);
    width: 650px;
    height: 420px;
    background: radial-gradient(
      circle,
      rgba(var(--navy-electric-rgb), 0.35) 0%,
      rgba(var(--deep-twilight-rgb), 0.25) 45%,
      transparent 70%
    );
    filter: blur(90px);
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Insignia / Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 1.1rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: #c7d2fe;
    background: rgba(var(--deep-twilight-rgb), 0.6);
    border: 1px solid rgba(var(--navy-electric-rgb), 0.45);
    border-radius: 9999px;
    margin-bottom: 2rem;
    box-shadow: 0 0 25px -4px rgba(var(--navy-electric-rgb), 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    letter-spacing: 0.03em;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    background-color: #818cf8;
    border-radius: 50%;
    box-shadow: 0 0 8px #818cf8;
    animation: pulse-dot 2s infinite ease-in-out;
  }

  @keyframes pulse-dot {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.85);
    }
  }

  /* Título Principal */
  .hero-title {
    font-size: clamp(2.35rem, 5.5vw + 1rem, 4.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: #ffffff;
    margin: 0 0 1.5rem;
    max-width: 860px;
    text-wrap: balance;
  }

  .highlight-gradient {
    background: linear-gradient(135deg, #ffffff 20%, #e0e7ff 60%, #a5b4fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Subtítulo / Descripción */
  .hero-description {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.65;
    color: #94a3b8;
    max-width: 680px;
    margin: 0 0 2.75rem;
    text-wrap: pretty;
  }

  /* Botón de Llamado a la Acción (CTA) */
  .hero-cta,
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.95rem 2.2rem;
    font-size: 1.05rem;
    font-weight: 600;
    font-family: inherit;
    color: #ffffff;
    text-decoration: none;
    cursor: pointer;
    background: linear-gradient(
      135deg,
      var(--deep-twilight) 0%,
      var(--navy) 50%,
      var(--navy-electric) 100%
    );
    border: 1px solid rgba(var(--navy-electric-rgb), 0.75);
    border-radius: 9999px;
    box-shadow:
      0 4px 25px -2px rgba(var(--navy-electric-rgb), 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .hero-cta:hover,
  button:hover {
    transform: translateY(-3px);
    box-shadow:
      0 8px 35px 2px rgba(var(--navy-electric-rgb), 0.75),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
    border-color: rgba(255, 255, 255, 0.45);
  }

  .hero-cta:active,
  button:active {
    transform: translateY(-1px);
    box-shadow: 0 4px 18px rgba(var(--navy-electric-rgb), 0.6);
  }

  .hero-cta:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--navy-electric);
    outline-offset: 4px;
  }

  /* Icono Flecha hacia abajo */
  .arrow-icon {
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
    transition: transform 0.25s ease;
  }

  .hero-cta:hover .arrow-icon,
  button:hover .arrow-icon {
    animation: bounce-subtle 1.2s infinite ease-in-out;
  }

  @keyframes bounce-subtle {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(5px);
    }
  }

  /* Responsivo */
  @media (max-width: 640px) {
    .hero {
      padding: 5rem 1.25rem 4rem;
      min-height: 70vh;
    }

    .hero-badge {
      font-size: 0.8rem;
      padding: 0.3rem 0.9rem;
      margin-bottom: 1.25rem;
    }

    .hero-title {
      margin-bottom: 1.2rem;
    }

    .hero-description {
      margin-bottom: 2rem;
    }

    .hero-cta,
    button {
      width: 100%;
      max-width: 320px;
      padding: 0.85rem 1.6rem;
      font-size: 1rem;
    }

    .hero::before {
      width: 340px;
      height: 280px;
    }
  }
</style>
