---
const { placeholder = "Buscar publicaciones, temas o tecnologías..." } =
  Astro.props;
---

<div class="search-form-container">
  <form
    action={Astro.url.pathname}
    method="GET"
    id="searchForm"
    class="search-form"
    role="search"
  >
    <svg
      class="search-icon"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 640 640"
      aria-hidden="true"
    >
      <path
        d="M480 272C480 317.9 465.1 360.3 440 394.7L566.6 521.4C579.1 533.9 579.1 554.2 566.6 566.7C554.1 579.2 533.8 579.2 521.3 566.7L394.7 440C360.3 465.1 317.9 480 272 480C157.1 480 64 386.9 64 272C64 157.1 157.1 64 272 64C386.9 64 480 157.1 480 272zM272 416C351.5 416 416 351.5 416 272C416 192.5 351.5 128 272 128C192.5 128 128 192.5 128 272C128 351.5 192.5 416 272 416z"
      ></path>
    </svg>

    <input
      type="search"
      name="q"
      id="searchInput"
      class="search-input"
      placeholder={placeholder}
      autocomplete="off"
      aria-label="Buscar publicaciones"
    />

    <button type="submit" class="search-submit-btn" aria-label="Buscar">
      Buscar
    </button>
  </form>
</div>

<script>
  function main() {
    const searchInput = document.getElementById("searchInput");

    if (searchInput instanceof HTMLInputElement) {
      const query = new URLSearchParams(window.location.search).get("q") ?? "";
      searchInput.value = query;
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    main();
  });

  document.addEventListener("astro:after-swap", () => {
    main();
  });
</script>

<style>
  .search-form-container {
    width: 100%;
    max-width: 580px;
    margin: 1.5rem auto 2.5rem;
  }

  .search-form {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    padding: 0.35rem 0.5rem 0.35rem 1.25rem;
    background-color: rgba(var(--prussian-blue-rgb), 0.6);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(var(--navy-rgb), 0.5);
    border-radius: 9999px;
    box-shadow:
      0 4px 20px -2px rgba(var(--black-rgb), 0.7),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      background-color 0.25s ease;
  }

  .search-form:hover {
    border-color: rgba(var(--navy-electric-rgb), 0.5);
    background-color: rgba(var(--prussian-blue-rgb), 0.75);
  }

  .search-form:focus-within {
    border-color: var(--navy-electric);
    background-color: rgba(var(--deep-twilight-rgb), 0.65);
    box-shadow:
      0 0 25px -2px rgba(var(--navy-electric-rgb), 0.5),
      0 8px 30px rgba(var(--black-rgb), 0.8),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
  }

  .search-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    fill: #818cf8;
    transition:
      fill 0.25s ease,
      transform 0.25s ease,
      filter 0.25s ease;
  }

  .search-form:focus-within .search-icon {
    fill: #ffffff;
    filter: drop-shadow(0 0 8px rgba(var(--navy-electric-rgb), 0.9));
    transform: scale(1.05);
  }

  .search-input {
    flex: 1;
    min-width: 0;
    padding: 0.65rem 0.85rem;
    background: transparent;
    border: none;
    outline: none;
    font-family: inherit;
    font-size: 0.975rem;
    color: #ffffff;
  }

  .search-input::placeholder {
    color: #64748b;
    transition: color 0.2s ease;
  }

  .search-form:focus-within .search-input::placeholder {
    color: #94a3b8;
  }

  /* Remueve estilos por defecto de cancelar en navegadores WebKit */
  .search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .search-submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 1.25rem;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    color: #ffffff;
    background: linear-gradient(
      135deg,
      var(--deep-twilight) 0%,
      var(--navy) 60%,
      var(--navy-electric) 100%
    );
    border: 1px solid rgba(var(--navy-electric-rgb), 0.6);
    border-radius: 9999px;
    cursor: pointer;
    box-shadow: 0 2px 10px rgba(var(--navy-electric-rgb), 0.35);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease,
      opacity 0.2s ease;
    flex-shrink: 0;
  }

  .search-submit-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(var(--navy-electric-rgb), 0.6);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .search-submit-btn:active {
    transform: translateY(0);
    box-shadow: 0 2px 8px rgba(var(--navy-electric-rgb), 0.4);
  }

  .search-submit-btn:focus-visible {
    outline: 2px solid var(--navy-electric);
    outline-offset: 2px;
  }

  @media (max-width: 640px) {
    .search-form-container {
      margin: 1.25rem auto 2rem;
    }

    .search-form {
      padding: 0.25rem 0.35rem 0.25rem 1rem;
    }

    .search-input {
      font-size: 0.9rem;
      padding: 0.55rem 0.65rem;
    }

    .search-submit-btn {
      padding: 0.45rem 0.95rem;
      font-size: 0.825rem;
    }

    .search-icon {
      width: 1.1rem;
      height: 1.1rem;
    }
  }
</style>
