---
import "../styles/global.css";

import Navbar from "../components/Navbar.astro";
import { SEO } from "astro-seo";

const {
  title = "DevLab",
  description = "Blog sobre programación y tecnología.",
  postTitle,
  postDescription,
  categories = [],
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <SEO title={title} description={description} />
  </head>
  <body>
    <Navbar />
    <header class="post-header">
      <a class="back-link" href="/posts">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 640 640"
          aria-hidden="true"
          ><path
            d="M73.4 297.4C60.9 309.9 60.9 330.2 73.4 342.7L233.4 502.7C245.9 515.2 266.2 515.2 278.7 502.7C291.2 490.2 291.2 469.9 278.7 457.4L173.3 352L544 352C561.7 352 576 337.7 576 320C576 302.3 561.7 288 544 288L173.3 288L278.7 182.6C291.2 170.1 291.2 149.8 278.7 137.3C266.2 124.8 245.9 124.8 233.4 137.3L73.4 297.3z"
          ></path></svg
        > Volver a los artículos</a
      >

      <div class="post-heading">
        {
          categories.length > 0 && (
            <ul class="post-categories" aria-label="Categorías">
              {categories.map((category: string) => (
                <li>{category}</li>
              ))}
            </ul>
          )
        }
        <h1>{postTitle}</h1>
        {postDescription && <p class="post-description">{postDescription}</p>}
      </div>
    </header>
    <main id="post">
      <slot />
    </main>
  </body>
</html>

<style>
  .post-header {
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 8vw, 6.5rem) max(1.25rem, calc((100% - 860px) / 2));
    background:
      radial-gradient(
        ellipse at 85% 20%,
        rgba(var(--navy-electric-rgb), 0.34),
        transparent 42%
      ),
      linear-gradient(
        145deg,
        rgba(var(--prussian-blue-rgb), 0.98),
        rgba(var(--deep-twilight-rgb), 0.88)
      );
    border-bottom: 1px solid rgba(148, 163, 255, 0.14);
  }

  .post-header::after {
    position: absolute;
    right: -5rem;
    bottom: -10rem;
    width: 24rem;
    height: 24rem;
    border: 1px solid rgba(199, 210, 254, 0.12);
    border-radius: 50%;
    box-shadow:
      0 0 0 2.5rem rgba(199, 210, 254, 0.025),
      0 0 0 5rem rgba(199, 210, 254, 0.02);
    content: "";
    pointer-events: none;
  }

  .back-link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #c7d2fe;
    font-size: 0.9rem;
    text-decoration: none;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .back-link:hover {
    color: #ffffff;
    transform: translateX(-3px);
  }

  .back-link svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }

  .back-link:focus-visible {
    border-radius: 0.2rem;
    outline: 2px solid #a5b4fc;
    outline-offset: 4px;
  }

  .post-heading {
    position: relative;
    z-index: 1;
    max-width: 780px;
    margin: clamp(2.5rem, 7vw, 4.5rem) auto 0;
  }

  .post-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
  }

  .post-categories li {
    padding: 0.35rem 0.75rem;
    color: #dbeafe;
    background: rgba(var(--navy-electric-rgb), 0.22);
    border: 1px solid rgba(165, 180, 252, 0.25);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .post-heading h1 {
    max-width: 740px;
    margin: 0;
    color: #ffffff;
    font-size: clamp(2.2rem, 6vw, 4.25rem);
    font-weight: 750;
    letter-spacing: -0.055em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .post-description {
    max-width: 660px;
    margin: 1.4rem 0 0;
    color: #cbd5e1;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.7;
  }

  #post {
    width: min(100% - 2.5rem, 780px);
    margin: 3.5rem auto 6rem;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    color: #dbe4f2;
    background: linear-gradient(
      145deg,
      rgba(12, 17, 46, 0.94),
      rgba(10, 8, 34, 0.96)
    );
    border: 1px solid rgba(148, 163, 255, 0.13);
    border-radius: 1.5rem;
    box-shadow: 0 24px 70px rgba(var(--black-rgb), 0.38);
  }

  @media (max-width: 640px) {
    .post-header {
      padding-top: 2.5rem;
      padding-bottom: 3rem;
    }

    #post {
      width: min(100% - 1.5rem, 780px);
      margin-top: 1.25rem;
      margin-bottom: 3rem;
      padding: 1.4rem;
      border-radius: 1rem;
    }
  }
</style>
