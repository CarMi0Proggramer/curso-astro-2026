---
import { getCollection, render } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";

export const getStaticPaths = async () => {
  const posts = await getCollection("posts");

  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content } = await render(post);
---

<PostLayout
  postTitle={post.data.title}
  postDescription={post.data.description}
  categories={post.data.categories}
>
  <article class="post-content">
    <Content />
  </article>
</PostLayout>

<style>
  .post-content {
    color: #dbe4f2;
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .post-content :global(> :first-child) {
    margin-top: 0;
  }

  .post-content :global(h2) {
    margin: 2.7rem 0 1rem;
    color: #ffffff;
    font-size: clamp(1.45rem, 3vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.25;
    text-wrap: balance;
  }

  .post-content :global(h3) {
    margin: 2rem 0 0.75rem;
    color: #e0e7ff;
    font-size: 1.3rem;
  }

  .post-content :global(p) {
    margin: 1.25rem 0;
  }

  .post-content :global(a) {
    color: #a5b4fc;
    text-decoration-color: rgba(165, 180, 252, 0.45);
    text-underline-offset: 0.2em;
    transition: color 0.2s ease;
  }

  .post-content :global(a:hover) {
    color: #ffffff;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 1.25rem 0;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin: 0.55rem 0;
    padding-left: 0.25rem;
  }

  .post-content :global(li::marker) {
    color: #818cf8;
  }

  .post-content :global(blockquote) {
    margin: 2rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    color: #c7d2fe;
    border-left: 3px solid #6366f1;
  }

  .post-content :global(pre) {
    overflow-x: auto;
    margin: 1.75rem 0;
    padding: 1.25rem;
    color: #e0e7ff;
    background: rgba(2, 1, 10, 0.65);
    border: 1px solid rgba(148, 163, 255, 0.16);
    border-radius: 0.8rem;
  }

  .post-content :global(code) {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.9em;
  }

  .post-content :global(:not(pre) > code) {
    padding: 0.15em 0.4em;
    color: #c4b5fd;
    background: rgba(var(--navy-electric-rgb), 0.2);
    border-radius: 0.35rem;
  }

  .post-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2rem auto;
    border: 1px solid rgba(148, 163, 255, 0.16);
    border-radius: 1rem;
  }

  .post-content :global(hr) {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid rgba(148, 163, 255, 0.18);
  }
</style>
