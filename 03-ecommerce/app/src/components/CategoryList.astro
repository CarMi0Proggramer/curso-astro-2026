---
const { categories } = Astro.props;
---

<nav class="category-list" aria-labelledby="category-list-title">
  <h2 id="category-list-title" class="category-list__title">Categorías</h2>

  {
    categories.length === 0 ? (
      <p class="category-list__empty">No hay categorías disponibles.</p>
    ) : (
      <ul class="category-list__items">
        {categories.map((category: any) => (
          <li>
            <a
              class="category-list__link"
              href={`/categories/${category.slug}`}
            >
              {category.name}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</nav>

<style>
  .category-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .category-list__title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .category-list__items {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .category-list__link {
    display: inline-flex;
    padding: 0.45rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background-color: var(--color-surface);
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 600;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .category-list__link:hover {
    background-color: var(--color-surface-hover);
    border-color: var(--color-primary);
    color: var(--color-accent);
  }

  .category-list__link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .category-list__empty {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
