---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import { Image } from "astro:assets";
import { formatPrice } from "../utils/format-price";
import { getCartDetails } from "../lib/cart/get-cart-details";

const cart = Astro.session ? ((await Astro.session.get("cart")) ?? []) : [];
const cartDetails = await getCartDetails(cart);
---

<Layout title="Shop — Carrito">
  <Navbar />
  <main class="cart-page">
    <h1 class="cart-page__title">Carrito de compras</h1>
    {
      cart.length === 0 ? (
        <div class="cart-page__empty">
          <p>Tu carrito está vacío.</p>
          <a class="cart-page__cta" href="/products">
            Ver productos
          </a>
        </div>
      ) : (
        <div class="cart-page__content">
          <ul class="cart-page__list">
            {cartDetails.items.map(({ product, quantity, subtotal }) => (
              <li
                class="cart-item"
                data-cart-item
                data-document-id={product.documentId}
              >
                <a class="cart-item__media" href={`/products/${product.slug}`}>
                  <Image
                    class="cart-item__image"
                    src={product.image}
                    alt={product.name}
                    width={96}
                    height={96}
                    loading="lazy"
                    decoding="async"
                  />
                </a>

                <div class="cart-item__info">
                  <a class="cart-item__name" href={`/products/${product.slug}`}>
                    {product.name}
                  </a>
                  <p class="cart-item__price">
                    {formatPrice(product.price)} c/u
                  </p>
                </div>

                <div
                  class="cart-item__quantity"
                  role="group"
                  aria-label={`Cantidad de ${product.name}`}
                >
                  <button
                    class="cart-item__btn"
                    type="button"
                    data-cart-decrease
                    data-document-id={product.documentId}
                    aria-label={`Quitar una unidad de ${product.name}`}
                  >
                    −
                  </button>
                  <span
                    class="cart-item__count"
                    data-cart-quantity
                    aria-live="polite"
                  >
                    {quantity}
                  </span>
                  <button
                    class="cart-item__btn"
                    type="button"
                    data-cart-increase
                    data-document-id={product.documentId}
                    aria-label={`Agregar una unidad de ${product.name}`}
                    disabled={quantity >= (product.stock ?? 0)}
                  >
                    +
                  </button>
                </div>

                <p class="cart-item__subtotal" data-cart-subtotal>
                  {formatPrice(subtotal)}
                </p>
              </li>
            ))}
          </ul>

          <aside class="cart-page__summary" aria-label="Resumen del pedido">
            <p class="cart-page__summary-row">
              <span>Artículos</span>
              <span data-cart-item-count>{cartDetails.itemCount}</span>
            </p>
            <p class="cart-page__summary-row cart-page__summary-row--total">
              <span>Total</span>
              <span data-cart-total>{formatPrice(cartDetails.total)}</span>
            </p>
            <button
              class="cart-page__checkout"
              type="button"
              data-cart-checkout
            >
              Proceder al checkout
            </button>
          </aside>
        </div>
      )
    }
  </main>
</Layout>

<script>
  import { actions } from "astro:actions";
  import { $cart } from "../stores/cart";
  import { formatPrice } from "../utils/format-price";

  const itemCountEl = document.querySelector("[data-cart-item-count]");
  const totalEl = document.querySelector("[data-cart-total]");
  const cartItems = document.querySelectorAll("[data-cart-item]");

  function updateCartStats(cartDetails: any) {
    const itemCount = cartDetails.itemCount;
    $cart.set({ itemCount });

    if (itemCountEl) {
      itemCountEl.textContent = itemCount.toString();
    }

    if (totalEl) {
      const total = cartDetails.items.reduce(
        (acc: any, curr: any) => acc + curr.subtotal,
        0,
      );
      totalEl.textContent = formatPrice(total);
    }
  }

  function updateCartItem(cartItem: any, cartDetails: any) {
    const documentId = cartItem.dataset.documentId;
    const itemDetails = cartDetails.items.find(
      (item: any) => item.product.documentId === documentId,
    );

    if (itemDetails) {
      const quantityEl = cartItem.querySelector("[data-cart-quantity]");
      const subtotalEl = cartItem.querySelector("[data-cart-subtotal]");

      if (quantityEl) {
        quantityEl.textContent = itemDetails.quantity.toString();
      }

      if (subtotalEl) {
        subtotalEl.textContent = formatPrice(itemDetails.subtotal);
      }
    }
  }

  cartItems.forEach((cartItem) => {
    const increaseBtn = cartItem.querySelector("[data-cart-increase]");
    const decreaseBtn = cartItem.querySelector("[data-cart-decrease]");

    if (increaseBtn instanceof HTMLElement) {
      increaseBtn?.addEventListener("click", async () => {
        const documentId = increaseBtn.dataset.documentId ?? "";
        const { data } = await actions.cart.increaseQuantity({ documentId });

        if (data?.itemCount === 0) {
          window.location.reload();
        } else {
          updateCartStats(data);
          updateCartItem(cartItem, data);
        }
      });
    }

    if (decreaseBtn instanceof HTMLElement) {
      decreaseBtn?.addEventListener("click", async () => {
        const documentId = decreaseBtn.dataset.documentId ?? "";
        const { data } = await actions.cart.decreaseQuantity({ documentId });

        if (data?.itemCount === 0) {
          window.location.reload();
        } else {
          updateCartStats(data);
          updateCartItem(cartItem, data);
        }
      });
    }
  });

  const checkoutBtn = document.querySelector("[data-cart-checkout]");

  checkoutBtn?.addEventListener("click", async () => {
    const { data, error } = await actions.payment.createPaymentIntent();

    if (error) {
      console.error("No se pudo iniciar el checkout", error);
      return;
    }

    window.location.href = data.url ?? "";
  });
</script>

<style>
  .cart-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: calc(var(--space-lg) * 1.5) var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .cart-page__title {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 800;
  }

  .cart-page__notice {
    margin: 0;
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    color: var(--color-text-muted);
  }

  .cart-page__empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    color: var(--color-text-muted);
  }

  .cart-page__empty p {
    margin: 0;
  }

  .cart-page__cta {
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    background-color: var(--color-primary);
    color: var(--color-primary-contrast);
  }

  .cart-page__cta:hover {
    background-color: var(--color-primary-hover);
  }

  .cart-page__content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    align-items: start;
  }

  @media (min-width: 900px) {
    .cart-page__content {
      grid-template-columns: 1fr 320px;
    }
  }

  .cart-page__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .cart-page__summary {
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .cart-page__summary-row {
    margin: 0;
    display: flex;
    justify-content: space-between;
    color: var(--color-text-muted);
  }

  .cart-page__summary-row--total {
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 1.25rem;
    font-weight: 800;
  }

  .cart-page__checkout {
    margin-top: var(--space-sm);
    width: 100%;
    border: none;
    background-color: var(--color-primary);
    color: var(--color-primary-contrast);
    font: inherit;
    font-weight: 700;
    padding: 0.85rem var(--space-lg);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .cart-page__checkout:hover {
    background-color: var(--color-primary-hover);
  }

  .cart-page__checkout:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .cart-item {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: var(--space-md);
    align-items: center;
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
  }

  @media (min-width: 640px) {
    .cart-item {
      grid-template-columns: 96px 1fr auto auto;
    }
  }

  .cart-item__media {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    padding: var(--space-sm);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg);
  }

  .cart-item__image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .cart-item__info {
    min-width: 0;
  }

  .cart-item__name {
    font-weight: 600;
  }

  .cart-item__name:hover {
    color: var(--color-primary-hover);
  }

  .cart-item__price {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .cart-item__quantity {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .cart-item__btn {
    width: 36px;
    height: 36px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: 1.125rem;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .cart-item__btn:hover:not(:disabled) {
    background-color: var(--color-surface-hover);
    border-color: var(--color-primary);
  }

  .cart-item__btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .cart-item__btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .cart-item__count {
    min-width: 2ch;
    text-align: center;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .cart-item__subtotal {
    margin: 0;
    font-weight: 700;
    text-align: right;
  }
</style>
