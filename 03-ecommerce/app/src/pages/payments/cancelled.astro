---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
---

<Layout title="Pago cancelado — Shop">
  <Navbar />
  <main class="payment-cancelled">
    <section
      class="payment-cancelled__card"
      aria-labelledby="payment-cancelled-title"
    >
      <svg
        class="payment-cancelled__icon"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="56"
        height="56"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M15 9l-6 6M9 9l6 6"></path>
      </svg>

      <h1 id="payment-cancelled-title" class="payment-cancelled__title">
        Pago cancelado
      </h1>
      <p class="payment-cancelled__message">
        No se realizó ningún cargo. Tus productos siguen en el carrito para que
        puedas completar la compra cuando quieras.
      </p>

      <div class="payment-cancelled__actions">
        <a
          class="payment-cancelled__btn payment-cancelled__btn--primary"
          href="/cart"
        >
          Volver al carrito
        </a>
        <a class="payment-cancelled__btn" href="/products">Seguir comprando</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .payment-cancelled {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: calc(var(--space-lg) * 3) var(--space-lg);
    display: flex;
    justify-content: center;
  }

  .payment-cancelled__card {
    max-width: 32rem;
    width: 100%;
    padding: calc(var(--space-lg) * 1.5) var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  .payment-cancelled__icon {
    color: var(--color-accent);
  }

  .payment-cancelled__title {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 800;
  }

  .payment-cancelled__message {
    margin: 0;
    color: var(--color-text-muted);
    max-width: 44ch;
  }

  .payment-cancelled__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .payment-cancelled__btn {
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-bg);
    color: var(--color-text);
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .payment-cancelled__btn:hover {
    background-color: var(--color-surface-hover);
    border-color: var(--color-primary);
  }

  .payment-cancelled__btn--primary {
    border-color: var(--color-primary);
    background-color: var(--color-primary);
    color: var(--color-primary-contrast);
  }

  .payment-cancelled__btn--primary:hover {
    background-color: var(--color-primary-hover);
  }

  .payment-cancelled__btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
