---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import ProductDetail from "../../components/ProductDetail.astro";
import { getProductBySlug } from "../../lib/strapi/catalog";

const { slug } = Astro.params;

if (!slug) {
  return Astro.rewrite("/404");
}

let product = null;
let loadError = false;

try {
  product = await getProductBySlug(slug);
} catch (error) {
  console.error(`Failed to load product "${slug}" from Strapi:`, error);
  loadError = true;
}

if (!loadError && !product) {
  return Astro.rewrite("/404");
}

const pageTitle = product ? product.name : "Producto";
---

<Layout title={`Shop — ${pageTitle}`}>
  <Navbar />
  <main class="product-page">
    <a class="product-page__back" href="/products">← Todos los productos</a>
    {
      product ? (
        <ProductDetail product={product} />
      ) : (
        <p class="product-page__error" role="alert">
          No pudimos cargar el producto. Inténtalo de nuevo más tarde.
        </p>
      )
    }
  </main>
</Layout>

<style>
  .product-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: calc(var(--space-lg) * 1.5) var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .product-page__back {
    align-self: flex-start;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .product-page__back:hover {
    color: var(--color-text);
  }

  .product-page__error {
    margin: 0;
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    color: var(--color-text-muted);
  }
</style>
